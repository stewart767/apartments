<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes

    # Deny direct access to sensitive configuration and environment files
    <FilesMatch "(^\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan)">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Rewrite all incoming web traffic to the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
